[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://tools/curator.gd" id="1_cur"]
[ext_resource type="Script" path="res://tools/curator_canvas.gd" id="2_canvas"]

[node name="Curator" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

script = ExtResource("1_cur")

[node name="Bg" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.078, 0.078, 0.094, 1)

[node name="V" type="VBoxContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 10.0
offset_top = 8.0
offset_right = -10.0
offset_bottom = -8.0

; =====================================================================
; browse mode -- one node, so opening the editor hides the lot
; =====================================================================
[node name="Browse" type="VBoxContainer" parent="V"]
unique_name_in_owner = true
size_flags_vertical = 3

[node name="Bar" type="HFlowContainer" parent="V/Browse"]

[node name="Title" type="Label" parent="V/Browse/Bar"]
theme_override_colors/font_color = Color(0.941, 0.714, 0.302, 1)
theme_override_font_sizes/font_size = 15
text = "Sprite gallery"

[node name="Count" type="Label" parent="V/Browse/Bar"]
unique_name_in_owner = true
theme_override_colors/font_color = Color(0.553, 0.576, 0.627, 1)
theme_override_font_sizes/font_size = 12

[node name="Filter" type="LineEdit" parent="V/Browse/Bar"]
unique_name_in_owner = true
custom_minimum_size = Vector2(150, 0)
placeholder_text = "Filter by name  (/)"
clear_button_enabled = true
tooltip_text = "Show only sprites whose name contains this. Press / to jump here, Esc to clear."

[node name="GroundBtn" type="Button" parent="V/Browse/Bar"]
unique_name_in_owner = true
tooltip_text = "The colour behind each sprite. Magenta is for spotting unstripped chroma key, which is invisible on the other two."
text = "Ground: light"

[node name="ZoomOut" type="Button" parent="V/Browse/Bar"]
unique_name_in_owner = true
tooltip_text = "Smaller thumbnails  —  minus key"
text = "–"

[node name="ZoomLabel" type="Label" parent="V/Browse/Bar"]
unique_name_in_owner = true
theme_override_colors/font_color = Color(0.553, 0.576, 0.627, 1)
theme_override_font_sizes/font_size = 12
text = "x3"

[node name="ZoomIn" type="Button" parent="V/Browse/Bar"]
unique_name_in_owner = true
tooltip_text = "Bigger thumbnails  —  plus key"
text = "+"

[node name="Rescan" type="Button" parent="V/Browse/Bar"]
unique_name_in_owner = true
tooltip_text = "Re-read art/ and re-scan the code for what it references  —  R"
text = "Rescan"

[node name="Scroll" type="ScrollContainer" parent="V/Browse"]
unique_name_in_owner = true
size_flags_vertical = 3

[node name="Grid" type="GridContainer" parent="V/Browse/Scroll"]
unique_name_in_owner = true
size_flags_horizontal = 3
columns = 7

; The action bar. The gallery's whole point is picking a sprite and
; editing it, and until this existed the only way in was an undiscoverable
; Enter or double-click. The selected sprite's name and its callers sit
; next to the button, so pressing Edit is never a guess about what opens.
[node name="SelBar" type="PanelContainer" parent="V/Browse"]

[node name="H" type="HBoxContainer" parent="V/Browse/SelBar"]

[node name="SelName" type="Label" parent="V/Browse/SelBar/H"]
unique_name_in_owner = true
theme_override_font_sizes/font_size = 14
text = "Nothing selected"

[node name="SelWhere" type="Label" parent="V/Browse/SelBar/H"]
unique_name_in_owner = true
theme_override_colors/font_color = Color(0.553, 0.576, 0.627, 1)
theme_override_font_sizes/font_size = 11
size_flags_horizontal = 3
text = "Click a sprite, or use the arrow keys."

[node name="NewBtn" type="Button" parent="V/Browse/SelBar/H"]
unique_name_in_owner = true
tooltip_text = "Start a blank sprite  —  N"
text = "New sprite"

[node name="EditBtn" type="Button" parent="V/Browse/SelBar/H"]
unique_name_in_owner = true
disabled = true
tooltip_text = "Open the selected sprite in the pixel editor  —  Enter, or double-click it"
text = "Edit sprite"

[node name="Report" type="RichTextLabel" parent="V/Browse"]
unique_name_in_owner = true
bbcode_enabled = true
fit_content = true
theme_override_font_sizes/normal_font_size = 12

; =====================================================================
; edit mode
; =====================================================================
[node name="Editor" type="VBoxContainer" parent="V"]
unique_name_in_owner = true
visible = false
size_flags_vertical = 3

; Save and Cancel used to sit at the end of a twenty-button row, the same
; size and shape as "Rect" and "4". They are the only two that end the
; session, so they get their own bar, always in the same corner.
[node name="Head" type="HBoxContainer" parent="V/Editor"]

[node name="EditTitle" type="Label" parent="V/Editor/Head"]
unique_name_in_owner = true
theme_override_colors/font_color = Color(0.941, 0.714, 0.302, 1)
theme_override_font_sizes/font_size = 15
text = "Editing"

[node name="Spacer" type="Control" parent="V/Editor/Head"]
size_flags_horizontal = 3

[node name="Undo" type="Button" parent="V/Editor/Head"]
unique_name_in_owner = true
tooltip_text = "Undo the last stroke  —  Ctrl+Z"
text = "Undo"

[node name="Redo" type="Button" parent="V/Editor/Head"]
unique_name_in_owner = true
tooltip_text = "Redo  —  Ctrl+Y"
text = "Redo"

[node name="Sep0" type="VSeparator" parent="V/Editor/Head"]

[node name="Cancel" type="Button" parent="V/Editor/Head"]
unique_name_in_owner = true
tooltip_text = "Close without saving  —  Esc"
text = "Cancel"

[node name="Save" type="Button" parent="V/Editor/Head"]
unique_name_in_owner = true
tooltip_text = "Write art/<name>.png and tools/sprites/<name>.txt  —  Ctrl+S"
text = "Save sprite"

[node name="Toolbar" type="HFlowContainer" parent="V/Editor"]

; --- tools ---
[node name="ToolG" type="VBoxContainer" parent="V/Editor/Toolbar"]

[node name="Cap" type="Label" parent="V/Editor/Toolbar/ToolG"]
theme_override_colors/font_color = Color(0.373, 0.396, 0.447, 1)
theme_override_font_sizes/font_size = 10
text = "TOOL"

[node name="Row" type="HBoxContainer" parent="V/Editor/Toolbar/ToolG"]

[node name="Brush" type="Button" parent="V/Editor/Toolbar/ToolG/Row"]
unique_name_in_owner = true
tooltip_text = "Brush — 1"
text = "Brush"
toggle_mode = true
button_pressed = true

[node name="Eraser" type="Button" parent="V/Editor/Toolbar/ToolG/Row"]
unique_name_in_owner = true
tooltip_text = "Eraser — 2"
text = "Eraser"
toggle_mode = true

[node name="Fill" type="Button" parent="V/Editor/Toolbar/ToolG/Row"]
unique_name_in_owner = true
tooltip_text = "Flood fill — 3"
text = "Fill"
toggle_mode = true

[node name="Eyedrop" type="Button" parent="V/Editor/Toolbar/ToolG/Row"]
unique_name_in_owner = true
tooltip_text = "Pick a colour off the sprite — 4   (right-click does it from any tool)"
text = "Pick"
toggle_mode = true

[node name="Line" type="Button" parent="V/Editor/Toolbar/ToolG/Row"]
unique_name_in_owner = true
tooltip_text = "Line — 5   (hold Shift for 45°)"
text = "Line"
toggle_mode = true

[node name="Rect" type="Button" parent="V/Editor/Toolbar/ToolG/Row"]
unique_name_in_owner = true
tooltip_text = "Rectangle — 6"
text = "Rect"
toggle_mode = true

[node name="Ellipse" type="Button" parent="V/Editor/Toolbar/ToolG/Row"]
unique_name_in_owner = true
tooltip_text = "Ellipse — 7"
text = "Ellipse"
toggle_mode = true

[node name="SepA" type="VSeparator" parent="V/Editor/Toolbar"]

; --- nib ---
[node name="NibG" type="VBoxContainer" parent="V/Editor/Toolbar"]

[node name="Cap" type="Label" parent="V/Editor/Toolbar/NibG"]
theme_override_colors/font_color = Color(0.373, 0.396, 0.447, 1)
theme_override_font_sizes/font_size = 10
text = "NIB"

[node name="Row" type="HBoxContainer" parent="V/Editor/Toolbar/NibG"]

[node name="SizeMinus" type="Button" parent="V/Editor/Toolbar/NibG/Row"]
unique_name_in_owner = true
tooltip_text = "Smaller  —  ["
text = "–"

[node name="SizeLabel" type="Label" parent="V/Editor/Toolbar/NibG/Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(26, 0)
horizontal_alignment = 1
text = "1"

[node name="SizePlus" type="Button" parent="V/Editor/Toolbar/NibG/Row"]
unique_name_in_owner = true
tooltip_text = "Bigger  —  ]"
text = "+"

[node name="Size1" type="Button" parent="V/Editor/Toolbar/NibG/Row"]
unique_name_in_owner = true
tooltip_text = "1px nib"
text = "1"
toggle_mode = true
button_pressed = true

[node name="Size2" type="Button" parent="V/Editor/Toolbar/NibG/Row"]
unique_name_in_owner = true
tooltip_text = "2px nib"
text = "2"
toggle_mode = true

[node name="Size4" type="Button" parent="V/Editor/Toolbar/NibG/Row"]
unique_name_in_owner = true
tooltip_text = "4px nib"
text = "4"
toggle_mode = true

[node name="Size8" type="Button" parent="V/Editor/Toolbar/NibG/Row"]
unique_name_in_owner = true
tooltip_text = "8px nib"
text = "8"
toggle_mode = true

[node name="Size16" type="Button" parent="V/Editor/Toolbar/NibG/Row"]
unique_name_in_owner = true
tooltip_text = "16px nib — the widest"
text = "16"
toggle_mode = true

[node name="Round" type="CheckButton" parent="V/Editor/Toolbar/NibG/Row"]
unique_name_in_owner = true
tooltip_text = "Round nib instead of square"
text = "Round"

[node name="SepB" type="VSeparator" parent="V/Editor/Toolbar"]

; --- shape and mirror ---
[node name="ShapeG" type="VBoxContainer" parent="V/Editor/Toolbar"]

[node name="Cap" type="Label" parent="V/Editor/Toolbar/ShapeG"]
theme_override_colors/font_color = Color(0.373, 0.396, 0.447, 1)
theme_override_font_sizes/font_size = 10
text = "SHAPE & SYMMETRY"

[node name="Row" type="HBoxContainer" parent="V/Editor/Toolbar/ShapeG"]

[node name="Filled" type="CheckButton" parent="V/Editor/Toolbar/ShapeG/Row"]
unique_name_in_owner = true
tooltip_text = "Fill rectangles and ellipses instead of outlining them"
text = "Filled"

[node name="Mirror" type="Button" parent="V/Editor/Toolbar/ShapeG/Row"]
unique_name_in_owner = true
tooltip_text = "Mirror strokes across the sprite, or across the character cell on a sheet  —  M cycles off / X / Y / XY"
text = "Mirror: off"

; --- colour ---
[node name="Colours" type="HBoxContainer" parent="V/Editor"]

[node name="SpriteG" type="VBoxContainer" parent="V/Editor/Colours"]

[node name="Cap" type="Label" parent="V/Editor/Colours/SpriteG"]
theme_override_colors/font_color = Color(0.373, 0.396, 0.447, 1)
theme_override_font_sizes/font_size = 10
text = "ALREADY IN THIS SPRITE"

[node name="SwatchRow" type="HBoxContainer" parent="V/Editor/Colours/SpriteG"]
unique_name_in_owner = true

[node name="SepC" type="VSeparator" parent="V/Editor/Colours"]

[node name="HouseG" type="VBoxContainer" parent="V/Editor/Colours"]
size_flags_horizontal = 3

[node name="Cap" type="Label" parent="V/Editor/Colours/HouseG"]
theme_override_colors/font_color = Color(0.373, 0.396, 0.447, 1)
theme_override_font_sizes/font_size = 10
text = "HOUSE PALETTE  (tools/palette.json) — click to paint with it"

[node name="HouseRow" type="HFlowContainer" parent="V/Editor/Colours/HouseG"]
unique_name_in_owner = true

[node name="Body" type="HBoxContainer" parent="V/Editor"]
size_flags_vertical = 3

[node name="CanvasWrap" type="ScrollContainer" parent="V/Editor/Body"]
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="Canvas" type="Control" parent="V/Editor/Body/CanvasWrap"]
script = ExtResource("2_canvas")

; The canvas left half the editor empty, and the one thing the editor could
; not do was the thing the gallery exists for: look at the sprite against
; the grounds it will actually sit on. Magenta is here for the same reason
; it is a gallery ground -- unstripped chroma key is invisible on the other
; two, and this project has shipped it.
[node name="Side" type="VBoxContainer" parent="V/Editor/Body"]
custom_minimum_size = Vector2(184, 0)

[node name="Cap" type="Label" parent="V/Editor/Body/Side"]
theme_override_colors/font_color = Color(0.373, 0.396, 0.447, 1)
theme_override_font_sizes/font_size = 10
text = "PREVIEW — ON EACH GROUND"

[node name="Previews" type="VBoxContainer" parent="V/Editor/Body/Side"]
unique_name_in_owner = true
size_flags_vertical = 3

[node name="Status" type="Label" parent="V/Editor"]
unique_name_in_owner = true
theme_override_font_sizes/font_size = 12
theme_override_colors/font_color = Color(0.75, 0.78, 0.82, 1)

[node name="Hints" type="Label" parent="V/Editor"]
unique_name_in_owner = true
theme_override_font_sizes/font_size = 11
theme_override_colors/font_color = Color(0.373, 0.396, 0.447, 1)
text = "1-7 tools    [ ] nib size    M mirror    +/- zoom    wheel zooms to the cursor    middle-drag pans    right-click picks a colour    arrows nudge the whole sprite"
