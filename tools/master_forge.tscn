; The gallery is the wider half and the forge panel is a fixed column of
; controls, but the split is draggable: the gallery reflows its columns to
; whatever width it is given (see curator.gd's _reflow), which is what the
; hard-coded 7 columns could not do -- they simply overflowed the pane and
; the right-hand sprites were cut off the edge of the window.
[node name="Art" type="HSplitContainer" parent="V/Tabs"]
layout_mode = 2
split_offset = 430

