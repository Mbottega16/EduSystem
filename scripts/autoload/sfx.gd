extends Node

## Sound. Registered as the `Sfx` autoload.
##
## In a 320x176 game with a fixed camera, audio is the main channel for
## "something just happened over there" — you cannot pan to it, and a
## boolean sprite toggle thirty tiles away is genuinely easy to miss. This
## is not polish; it is the second half of the game's feedback.
##
## Every sound is generated by tools/make_audio.py, the same way every image
## is generated by tools/make_art.py.

## A small pool so overlapping sounds don't cut each other off — eight
## students finishing at once should sound like eight sheets, not one.
const VOICES := 8

## Sounds that would become noise if fired every frame, and how long to
## suppress a repeat for.
const THROTTLE := {"step": 0.26, "stuck": 0.12, "blip": 0.05}

var enabled: bool = true
var volume_db: float = -6.0

var _players: Array[AudioStreamPlayer] = []
var _next: int = 0
var _streams: Dictionary = {}
var _last_played: Dictionary = {}


func _ready() -> void:
	for i in VOICES:
		var p := AudioStreamPlayer.new()
		p.bus = "Master"
		add_child(p)
		_players.append(p)


func play(name: String, pitch: float = 1.0) -> void:
	if not enabled:
		return

	var now := Time.get_ticks_msec() / 1000.0
	if THROTTLE.has(name):
		var last := float(_last_played.get(name, -999.0))
		if now - last < float(THROTTLE[name]):
			return
	_last_played[name] = now

	var stream := _stream(name)
	if stream == null:
		return
	var p := _players[_next]
	_next = (_next + 1) % _players.size()
	p.stream = stream
	p.pitch_scale = pitch
	p.volume_db = volume_db
	p.play()


## Slight random pitch, so a repeated sound doesn't turn into a machine gun.
func play_varied(name: String, spread: float = 0.08) -> void:
	play(name, 1.0 + randf_range(-spread, spread))


func _stream(name: String) -> AudioStream:
	if _streams.has(name):
		return _streams[name]
	var path := "res://audio/%s.wav" % name
	if not ResourceLoader.exists(path):
		push_warning("no such sound: %s" % name)
		_streams[name] = null
		return null
	var s: AudioStream = load(path)
	_streams[name] = s
	return s
