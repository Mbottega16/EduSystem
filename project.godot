; EDUSystem — an embodied classroom. You are the teacher.

config_version=5

[application]

config/name="EDUSystem"
run/main_scene="res://scenes/ui/title.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

; Master and Music. Effects stay on Master; music.gd puts its three
; players on Music, and Settings.music_volume moves that bus alone.
buses/default_bus_layout="res://default_bus_layout.tres"

[autoload]

Game="*res://scripts/autoload/game.gd"
Sfx="*res://scripts/autoload/sfx.gd"
Music="*res://scripts/autoload/music.gd"
Settings="*res://scripts/autoload/settings.gd"

[display]

; The viewport is exactly the size of the room image (20x11 tiles of 32px,
; doubled from 16px in Aug 2026 for more detail per tile -- same 20x11 room,
; same layout, denser pixels), so the whole room is on screen at once and
; every pixel lands on a whole screen pixel when it scales up. Window
; override keeps the same 3x integer scale as before (960x528 at 320x176),
; so pixel edges stay crisp rather than blurring on a fractional scale.
window/size/viewport_width=640
window/size/viewport_height=352
window/size/window_width_override=1920
window/size/window_height_override=1056
window/stretch/mode="viewport"
; "expand", not "keep": with "keep" a window that is not exactly 20:11
; got black bars, and black bars are not a background. Expanding grows
; the VIEWPORT to the window's shape instead, so the extra space is
; real space the game draws into -- scenes/main.tscn's Backdrop layer
; fills it, and classroom.gd centres the room in it. The room itself is
; still 640x352 and still pixel-exact; nothing about it scales.
window/stretch/aspect="expand"
; Drag the window to any size. It was always true (Godot's default) but
; was never written down, and nothing in the game said so.
window/size/resizable=true

[input]

; Every action is bound by PHYSICAL keycode so WASD keeps its geometry on
; non-QWERTY layouts. Critically, these exist so tests can drive the game:
; Input.action_press() can trigger an action, but it can NOT trigger
; Input.is_physical_key_pressed(), which is how movement used to be read.

move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":65,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
