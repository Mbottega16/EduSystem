[node name="Main" type="Node2D"]
script = ExtResource("3_main")

; What shows AROUND the room. A CanvasLayer BELOW the world (layer -100)
; rather than a sprite in it: screen space means it fills whatever the
; window happens to be, in every room, without following a camera or
; being told how big to be. It exists because the stretch aspect is
; "expand" now -- see project.godot -- so a window that is not exactly
; 20:11 shows real space above and below the classroom.
[node name="Backdrop" type="CanvasLayer" parent="."]
layer = -100

[node name="Wall" type="TextureRect" parent="Backdrop"]
texture_repeat = 2
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
texture = ExtResource("7_backdrop")
stretch_mode = 1

[node name="World" type="Node2D" parent="."]
y_sort_enabled = true
script = ExtResource("1_world")

[node name="Hallway" parent="." instance=ExtResource("5_hall")]
position = Vector2(0, 10000)
visible = false

[node name="MentorRoom" parent="." instance=ExtResource("6_mentor")]
position = Vector2(0, 20000)
visible = false

[node name="PrincipalOffice" parent="." instance=ExtResource("8_office")]
position = Vector2(0, 30000)
visible = false

[node name="VisitRoom" parent="." instance=ExtResource("9_visit")]
position = Vector2(0, 40000)
visible = false

[node name="UI" type="CanvasLayer" parent="."]

[node name="HUD" parent="UI" instance=ExtResource("2_hud")]

[node name="Debug" type="CanvasLayer" parent="."]
script = ExtResource("4_dbg")
