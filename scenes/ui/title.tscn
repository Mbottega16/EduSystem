[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/title.gd" id="1_title"]
[ext_resource type="Theme" path="res://theme.tres" id="2_theme"]
[ext_resource type="Texture2D" path="res://art/student_c.png" id="4_walk"]

; The start page is the classroom's chalkboard (UI overhaul, Nov 2026).
;
; Three layers, back to front: the Board (the theme's chalkboard material,
; stretched to whatever shape the window is, with the chalk and the eraser
; on its bottom rail); the Title node's own children (the dust and the child
; who walks past); and the UI (everything written on the board). Root and
; Tray are CENTRED 640x352 boxes, the same trick as the HUD's root, so the
; words stay where they were authored on a window that is not 20:11.
;
; No font, size or colour is set here. Each label wears a variation of
; res://theme.tres and title.gd places the rows.
[node name="Title" type="Node2D"]
script = ExtResource("1_title")

[node name="Board" type="CanvasLayer" parent="."]
layer = -1

[node name="Panel" type="Panel" parent="Board"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme = ExtResource("2_theme")
theme_type_variation = &"TitleBoard"

[node name="Tray" type="Control" parent="Board"]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -320.0
offset_top = -176.0
offset_right = 320.0
offset_bottom = 176.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Walker" type="Sprite2D" parent="."]
position = Vector2(-40, 312)
texture = ExtResource("4_walk")
hframes = 15
vframes = 4
frame = 10

[node name="UI" type="CanvasLayer" parent="."]

[node name="Root" type="Control" parent="UI"]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -320.0
offset_top = -176.0
offset_right = 320.0
offset_bottom = 176.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme = ExtResource("2_theme")

[node name="Wordmark" type="Label" parent="UI/Root"]
offset_right = 640.0
offset_bottom = 90.0
mouse_filter = 2
theme_type_variation = &"ChalkTitle"
text = "EDUSystem"
horizontal_alignment = 1

[node name="Underline" type="ColorRect" parent="UI/Root"]
offset_left = 214.0
offset_top = 78.0
offset_right = 426.0
offset_bottom = 82.0
mouse_filter = 2

[node name="Heading" type="Label" parent="UI/Root"]
offset_top = 6.0
offset_right = 640.0
offset_bottom = 58.0
mouse_filter = 2
theme_type_variation = &"ChalkHeading"
horizontal_alignment = 1

[node name="Rows" type="Control" parent="UI/Root"]
offset_right = 640.0
offset_bottom = 352.0
mouse_filter = 2

[node name="Footer" type="Label" parent="UI/Root"]
offset_left = 40.0
offset_top = 304.0
offset_right = 600.0
offset_bottom = 334.0
mouse_filter = 2
theme_type_variation = &"ChalkNote"
horizontal_alignment = 1
