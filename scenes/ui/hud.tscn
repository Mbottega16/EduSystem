; A CENTRED 640x352 box, not the whole viewport.
;
; Every one of the nineteen children below is placed by absolute offset in
; a 640x352 space -- the status strip at y=0, the prompt bar at y=312, the
; book at 32,48 -- because for a year the viewport WAS exactly 640x352.
; Since the stretch aspect became "expand" (project.godot) it is whatever
; shape the monitor is, and a HUD anchored to the viewport put the prompt
; bar across the middle of the room on anything taller than 11 tiles.
;
; Anchoring the ROOT to the centre and giving it the old size keeps all
; nineteen exactly where they were authored, and lands them over the room
; -- which classroom.gd centres in the same viewport by the same maths.
; The alternative was re-anchoring nineteen nodes and the ~40 absolute
; Rect2 constants in hud.gd that agree with them.
[node name="HUD" type="Control"]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -320.0
offset_top = -176.0
offset_right = 320.0
offset_bottom = 176.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme = ExtResource("5_theme")
script = ExtResource("1_hud")

[node name="TopBar" type="ColorRect" parent="."]
offset_right = 640.0
offset_bottom = 26.0
mouse_filter = 2
color = Color(0.07, 0.05, 0.09, 0.72)

[node name="Status" type="Label" parent="."]
offset_left = 8.0
offset_top = 2.0
offset_right = 632.0
offset_bottom = 26.0
mouse_filter = 2
theme_override_colors/font_color = Color(0.95, 0.91, 0.77, 1)
theme_override_font_sizes/font_size = 20
text = "Day 1"

[node name="PromptBox" type="ColorRect" parent="."]
visible = false
offset_top = 312.0
offset_right = 640.0
offset_bottom = 352.0
mouse_filter = 2
color = Color(0.07, 0.05, 0.09, 0.82)

